# Copy to .env and fill in. Never commit .env.

# --- LLM providers ---
# Google AI Studio: https://aistudio.google.com/apikey (free tier: 500 RPD)
GEMINI_API_KEY=

# Optional: Sapling AI text detection (used in the voice-check pipeline)
# https://sapling.ai
SAPLING_API_KEY=

# Optional: HuggingFace AI detection (second detector alongside Sapling)
# Free token from https://huggingface.co/settings/tokens — no credit card needed
HUGGINGFACE_API_KEY=

# --- Gmail rejection sync (optional) ---
# Requires an app-specific password: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# --- Applicant identity (used by auto-apply and form-fill) ---
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LINKEDIN=
APPLICANT_GITHUB=
APPLICANT_CITY=
# Alias: APPLICANT_LOCATION works the same as APPLICANT_CITY
APPLICANT_LOCATION=
APPLICANT_PIN_CODE=
APPLICANT_CURRENT_COMPANY=
APPLICANT_COUNTRY=India
APPLICANT_HEARD_ABOUT=LinkedIn
APPLICANT_DESIRED_BASE_SALARY=
APPLICANT_INDIA_WORK_AUTHORIZED=true
APPLICANT_INDIAN_CITIZEN=
APPLICANT_REQUIRES_SPONSORSHIP=false
APPLICANT_RESIDES_IN_INDIA=true
APPLICANT_BACKGROUND_CHECK_CONSENT=true
APPLICANT_AWS_EXPERIENCE=true
APPLICANT_KUBERNETES_EXPERIENCE=true
APPLICANT_WORKED_AT_EMPLOYER_BEFORE=false
APPLICANT_HAS_CONFLICT_OF_INTEREST=false

# Notice period in days (common in Indian recruitment: 0, 15, 30, 60, 90)
APPLICANT_NOTICE_PERIOD_DAYS=30

# Current CTC and expected CTC (in LPA — lakhs per annum)
APPLICANT_CURRENT_CTC=
APPLICANT_EXPECTED_CTC=

# PAN card (used for some Indian job portals)
APPLICANT_PAN=

# Aadhaar (optional, some employers ask)
APPLICANT_AADHAAR_AVAILABLE=true

# Optional: education (used for auto-filling Greenhouse education section)
APPLICANT_SCHOOL=
APPLICANT_FIELD_OF_STUDY=
APPLICANT_GRAD_YEAR=
APPLICANT_DEGREE=

# --- EEO / Diversity defaults ---
# Indian companies may ask about gender and disability status.
# These default to "prefer not to say" if unset.
APPLICANT_GENDER=
APPLICANT_DISABILITY_STATUS=
APPLICANT_CASTE_CATEGORY=

# --- Pipeline config ---
# Active profile. The default 'example' ships with the repo.
# To use your own, copy profiles/example to profiles/<your-name> and change this.
JOB_PROFILE_DIR=profiles/example
JOB_DB_PATH=profiles/example/jobs.db

# Dashboard HTTP port
DASHBOARD_PORT=3131
TZ=Asia/Kolkata

# --- Location filter ---
# Comma-separated list of cities/regions to always allow. Empty = allow all.
# Example: LOCATION_FILTER=bangalore,hyderabad,pune,mumbai
LOCATION_FILTER=
# Comma-separated list of cities/regions to always drop. Empty = block none.
LOCATION_BLOCKLIST=

# --- Naukri scraper ---
# Search keywords for Naukri.com scraping (uses SEARCH_TERMS from companies.js by default)
# Experience range in years for Naukri filtering
NAUKRI_EXPERIENCE_MIN=4
NAUKRI_EXPERIENCE_MAX=10

# --- Auto-apply ---
AUTO_APPLY_ENABLED=false
AUTO_APPLY_DRY_RUN=true
AUTO_APPLY_DAILY_SUCCESS_LIMIT=3
# Comma-separated list of ATS platforms to skip in unattended mode.
# Ashby is blocked by default because repeated automated submits can trigger spam warnings.
AUTO_APPLY_PLATFORM_BLOCKLIST=ashby
